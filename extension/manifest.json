{
  "manifest_version": 3,
  "name": "LankaJobs Saver",
  "version": "1.0.0",
  "description": "Save the job you are viewing to your LankaJobs dashboard with one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": { "default_popup": "popup.html", "default_title": "Save job to LankaJobs" }
}
