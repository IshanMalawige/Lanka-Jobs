DATABASE_URL=sqlite:///./jobs.db
# For PostgreSQL: postgresql://user:pass@localhost:5432/lankajobs
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
SCRAPE_INTERVAL_MINUTES=180
GMAIL_SYNC_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true
# Comma separated, used by the skill gap analyzer
MY_SKILLS=python,linux,networking,tcp/ip,cisco,windows server,sql,git,wireshark
# Telegram bot notifications require a bot token and the recipient's chat ID.
# The recipient must start the bot before it can send them messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MATCH_THRESHOLD=75
